# Server URL (the origin the app is served from; relative API URLs are used
# everywhere, so no /api suffix variable is needed)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Payload CMS
PAYLOAD_SECRET=your_payload_secret_here

# Host-run Next dev, migrations, tests and seeds connect over loopback. Compose
# overrides this with db:5432 for its containers. Keep the password in sync
# with POSTGRES_PASSWORD when changing it for VPS deployment.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/usthb_mosque
# Uncomment only in your local .env to opt in to fast dev schema push. The
# app/migrator containers force this off and use migrations instead.
# PAYLOAD_PUSH=true

# First admin bootstrap (pnpm bootstrap:admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_8_chars_min

# Host-run dev/e2e use loopback MinIO. Compose overrides S3_ENDPOINT with
# minio:9000 and uses these same credentials for the MinIO root account.
S3_ACCESS_KEY_ID=mosque
S3_SECRET_ACCESS_KEY=mosque-secret
S3_BUCKET=media
S3_REGION=local
S3_ENDPOINT=http://127.0.0.1:9000

# Vercel Blob fallback — on a Vercel deployment (any VERCEL env) Blob takes
# precedence whenever this token exists, even if stray S3 variables are set.
# Leave unset everywhere else.
# BLOB_READ_WRITE_TOKEN=

# Email (SMTP/Gmail)
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_app_password

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Optional e2e-only overrides; omit in production to use the Google endpoints.
# GOOGLE_AUTH_ENDPOINT=http://127.0.0.1:3200/o/oauth2/v2/auth
# GOOGLE_TOKEN_ENDPOINT=http://127.0.0.1:3200/token
# GOOGLE_USERINFO_ENDPOINT=http://127.0.0.1:3200/userinfo

# ---------------------------------------------------------------------------
# Docker deployment: set SITE_DOMAIN to a DNS name pointed at the VPS and
# NEXT_PUBLIC_SERVER_URL above to https://that-name before starting Caddy.
# Compose forces NODE_ENV=production and PAYLOAD_PUSH=false inside containers.
# SITE_DOMAIN=mosque.example.org
# Match DATABASE_URL above when changing the default Postgres password.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=usthb_mosque
# POSTGRES_PORT=5432
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
