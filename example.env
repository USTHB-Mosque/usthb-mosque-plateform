# Server URL (the origin the app is served from; relative API URLs are used
# everywhere, so no /api suffix variable is needed)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Dev only: extra origin (e.g. LAN IP when testing from a phone) added to Payload cors/csrf
NEXT_PUBLIC_DEV_ORIGIN=

# Payload CMS
PAYLOAD_SECRET=your_payload_secret_here

# Database (PostgreSQL connection string)
# - local dev (Supabase CLI):  postgresql://postgres:postgres@127.0.0.1:54322/postgres
# - docker compose:            postgresql://postgres:postgres@db:5432/usthb_mosque
# - any other host:            postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# First admin bootstrap (pnpm bootstrap:admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_8_chars_min

# Media storage — S3-compatible adapter, used in every environment when set.
# - Local dev (Supabase CLI): values below.
# - Docker compose: leave these UNSET and docker-compose.yml supplies the
#   bundled MinIO credentials (mosque / mosque-secret). To use another
#   S3-compatible provider instead, set the five variables to its values.
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key
S3_BUCKET=media
S3_REGION=local
S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3

# Vercel Blob fallback — on a Vercel deployment (any VERCEL env) Blob takes
# precedence whenever this token exists, even if stray S3 variables are set.
# Leave unset everywhere else.
# BLOB_READ_WRITE_TOKEN=

# Email (SMTP/Gmail)
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_app_password

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Node Environment
NODE_ENV=development

# ---------------------------------------------------------------------------
# Docker deploy only (docker-compose.yml) — all have safe defaults, uncomment
# to change:
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=change_me
# POSTGRES_DB=usthb_mosque
# APP_PORT=3000
# MINIO_ROOT_USER=mosque
# MINIO_ROOT_PASSWORD=mosque-secret
# MINIO_CONSOLE_PORT=9001
